DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

PORT=5006
BACKEND_BASE_URL="http://localhost:5006"

JWT_SECRET="generate-a-long-random-value-do-not-reuse-across-projects"
GEN_SALT=10
EXPIRES_IN=15d

EMAIL="support@example.com"
APP_PASS="app-specific-password"

# --- DigitalOcean Spaces (file storage) ---
DO_SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
DO_SPACES_REGION="nyc3"
DO_SPACES_ACCESS_KEY_ID=""
DO_SPACES_SECRET_ACCESS_KEY=""
DO_SPACES_BUCKET=""

# --- OneSignal (push notifications) ---
ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""

# --- Firebase Admin SDK ---
# Base64-encode the service account JSON's contents into this single value.
FIREBASE_SERVICE_ACCOUNT_BASE64=""
